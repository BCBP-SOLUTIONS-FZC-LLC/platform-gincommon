# Copy to .env for local development: make setup (or cp .env-example .env)
#
# Only values that differ from a built-in default are set here. Every other
# variable falls back to a default in internal/config, the Makefile (?=) or
# docker-compose.yml (${VAR:-default}). Uncomment a line only to override it.

# --- Demo server identity (read by the library) ---
# Required. Registry domain (iam, workflow, billing, tender_management,
# notifications, documents, bff, portal): the domain label on every metric.
OBSERVABILITY_DOMAIN=iam
# Environment label and dev defaults (plaintext OTLP, 100% sampling, debug
# console logs). One of local, dev, test, staging, prod.
APP_ENV=dev
# BUILD_VERSION is left unset so the Makefile stamps `git describe` output.
# BUILD_VERSION=dev

# --- OpenTelemetry (read by the library) ---
# Defaults: endpoint localhost:4317 (OTLP/gRPC); insecure when APP_ENV is
# dev/local; sample ratio 1.0 in dev/local, 0.1 otherwise; service name from
# OTEL_SERVICE_NAME, then APP_NAME (the demo's APP_NAME defaults to
# platform-gincommon).
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
# OTEL_TRACES_SAMPLER_RATIO=1.0
# OTEL_TRACES_IGNORE_REMOTE_PARENT_SAMPLED=false
# OTEL_PROPAGATOR_BAGGAGE=false

# --- Logging (read by the library) ---
# Promtail ships this file into Loki when the local stack is running.
LOG_FILE=logs/app.log
# LOG_LEVEL=info          # debug | info | warn | error (default debug in dev/local)
# LOG_SAMPLING=false

# --- Local docker-compose stack only — NOT read by the library ---
# Do not copy these into a service's configuration. Defaults live in
# docker-compose.yml and the Makefile; override only on a port clash:
# OTEL_COLLECTOR_GRPC_PORT, OTEL_COLLECTOR_HTTP_PORT, LOKI_HTTP_PORT,
# PROMETHEUS_HTTP_PORT, GRAFANA_HTTP_PORT, PROMETHEUS_SCRAPE_TARGET
