# Copy to .env for local development: cp .env-example .env

# --- Application ---
APP_NAME=platform-gincommon
BUILD_VERSION=dev
APP_ENV=dev
APP_PORT=8080

# --- Smoke tests ---
SMOKE_BASE_URL=http://localhost:8080

# --- OpenTelemetry ---
# App uses OTLP/gRPC only (host:4317). Port 4318 is collector HTTP, not for otlptracegrpc.
OTEL_SERVICE_NAME=platform-gincommon
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTLP TLS: false in prod; defaults true when APP_ENV=dev
OTEL_EXPORTER_OTLP_INSECURE=true
# W3C baggage propagation (default false)
# OTEL_PROPAGATOR_BAGGAGE=false
# Trace sampling ratio 0.0–1.0 (default: 1.0 when APP_ENV=dev, 0.1 otherwise)
# OTEL_TRACES_SAMPLER_RATIO=1.0

# --- Observability stack (Docker host port mappings) ---
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
LOKI_HTTP_PORT=3100
PROMETHEUS_HTTP_PORT=9090
GRAFANA_HTTP_PORT=3000
PROMETHEUS_SCRAPE_TARGET=host.docker.internal:8080

# --- Integration / e2e tests ---
TEST_SERVICE_NAME=test-service
E2E_SERVICE_NAME=e2e-test

# --- Tooling ---
GO=go
