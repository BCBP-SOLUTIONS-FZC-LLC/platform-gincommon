version: 2
updates:
  - package-ecosystem: gomod
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, go]

  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, github-actions]

  # Dockerfile base images (digest-pinned; re-run `make pin-base-images` so
  # .docker-digests stays in sync with the bumped FROM lines).
  - package-ecosystem: docker
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    labels: [dependencies, docker]

# DISABLED (temporarily) — GitHub only reads .github/dependabot.yml, so this renamed file
# stops scheduled version-update checks and new Dependabot PRs for gomod,
# github-actions and docker without losing the configuration.
#
# Re-enable:  git mv .github/dependabot.yml.disabled .github/dependabot.yml
#
# Note: this does not turn off Dependabot *alerts* or *security updates* —
# those are repository settings (Settings → Code security).
